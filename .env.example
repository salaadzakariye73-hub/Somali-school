# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB Atlas connection string.
# When omitted in local/preview mode, NEXUS SCHOOL OS uses its persistent local document store.
MONGODB_URI=

# INITIAL_SUPER_ADMIN_EMAIL: Optional first-run Super Admin seed email.
INITIAL_SUPER_ADMIN_EMAIL=

# INITIAL_SUPER_ADMIN_USERNAME: Optional first-run Super Admin username.
INITIAL_SUPER_ADMIN_USERNAME=

# INITIAL_SUPER_ADMIN_PASSWORD: Optional first-run Super Admin seed password.
# If omitted, the first visitor can securely claim the Super Admin account via the one-time setup screen.
INITIAL_SUPER_ADMIN_PASSWORD=

# INITIAL_SUPER_ADMIN_NAME: Optional display name for initial Super Admin.
INITIAL_SUPER_ADMIN_NAME=

# CORS_ORIGIN: Optional comma-separated allowed origins for production deployment (e.g. Cloudflare Pages URL).
CORS_ORIGIN=
